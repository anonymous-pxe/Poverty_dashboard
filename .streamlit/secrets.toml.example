# Streamlit Secrets Configuration Template
# Copy this file to secrets.toml and fill in your actual API keys
# For Streamlit Cloud: Add these secrets in the app settings dashboard

[api]
# India Poverty API (NDAP Platform)
india_poverty_api_key = "your-india-api-key-here"
india_poverty_api_url = "https://loadqa.ndapapi.com/v1/openapi"

# World Bank API (no key required, but can configure custom endpoint)
world_bank_api_url = "https://api.worldbank.org/v2"

[database]
# Optional: If you want to cache data in a database
# db_host = "your-db-host"
# db_port = "5432"
# db_name = "poverty_dashboard"
# db_user = "your-db-user"
# db_password = "your-db-password"

[settings]
# Application settings
cache_ttl = "3600"  # Cache time-to-live in seconds
